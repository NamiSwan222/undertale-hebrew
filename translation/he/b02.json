{
 "SCR_TEXT_901": "עמדת בפיתוי של&הפסטה הביתית&שלי.../",
 "SCR_TEXT_902": "רק כדי לחלוק&אותה איתי???/",
 "SCR_TEXT_905": "\\E0אל דאגה, בן אדם^1!&אני^1, מאסטר-שף&פאפירוס.../",
 "SCR_TEXT_906": "אכין לך את כל&הפסטה שרק&תרצה בחיים!/",
 "SCR_TEXT_907": "הה הה הה הה&הה הה נייה!/%%",
 "SCR_TEXT_911": "היי!/",
 "SCR_TEXT_912": "זה הבן אדם!/",
 "SCR_TEXT_913": "\\E0אתה הולך&להתאהב&בחידה הזאת!/",
 "SCR_TEXT_914": "ד\"ר אלפיס&המבריקה בנתה&אותה!/",
 "SCR_TEXT_915": "אתה רואה&את המשבצות&האלה!?/",
 "SCR_TEXT_916": "ברגע שאפעיל&את המתג הזה.../",
 "SCR_TEXT_917": "הן יתחילו&להחליף&צבעים!/",
 "SCR_TEXT_918": "לכל צבע יש&תפקיד&שונה!/",
 "SCR_TEXT_919": "משבצות אדומות&חוסמות את&הדרך!/",
 "SCR_TEXT_920": "אי אפשר&ללכת עליהן!/",
 "SCR_TEXT_921": "משבצות צהובות&הן חשמליות!/",
 "SCR_TEXT_922": "הן יחשמלו&אותך!/",
 "SCR_TEXT_923": "משבצות ירוקות&הן משבצות&אזעקה!/",
 "SCR_TEXT_924": "אם תדרוך&עליהן.../",
 "SCR_TEXT_925": "תצטרך להילחם&במפלצת!!/",
 "SCR_TEXT_926": "משבצות כתומות&הן בניחוח&תפוזים./",
 "SCR_TEXT_927": "הן יגרמו לך&להריח&טעים!/",
 "SCR_TEXT_928": "משבצות כחולות&הן משבצות מים!/",
 "SCR_TEXT_929": "אפשר לשחות בהן&אם בא לך^1,&אבל.../",
 "SCR_TEXT_930": "אם אתה מריח&כמו תפוזים!/",
 "SCR_TEXT_931": "הפיראנות&ינשכו&אותך!/",
 "SCR_TEXT_932": "וגם^1, אם משבצת&כחולה נמצאת&ליד משבצת,/",
 "SCR_TEXT_933": "צהובה^1,&המים גם&יחשמלו אותך!/",
 "SCR_TEXT_934": "משבצות סגולות&הן חלקלקות!/",
 "SCR_TEXT_935": "תחליק&למשבצת&הבאה!/",
 "SCR_TEXT_936": "אבל^1, הסבון&החלקלק.../",
 "SCR_TEXT_937": "מריח כמו&לימונים!!/",
 "SCR_TEXT_938": "ופיראנות לא&סובלות לימונים!/",
 "SCR_TEXT_939": "סגול וכחול&זה בסדר!/",
 "SCR_TEXT_940": "ואחרונות&חביבות^1,&הוורודות./",
 "SCR_TEXT_941": "הן לא עושות&כלום./",
 "SCR_TEXT_942": "תדרוך עליהן&כמה שבא לך./",
 "SCR_TEXT_943": "נו, מה דעתך!^1?&הבנת???/",
 "SCR_TEXT_944": "\\TS \\F0 \\E0 \\T0 %",
 "SCR_TEXT_945": "* (הבנת את ההסבר?)& &         בטח         לא        \\C ",
 "SCR_TEXT_946": "   ",
 "SCR_TEXT_953": "מעולה!^1!&אז נשאר רק&דבר אחרון.../",
 "SCR_TEXT_954": "החידה הזאת.../",
 "SCR_TEXT_955": "היא אקראית לגמרי&!!!!!!/",
 "SCR_TEXT_956": "כשאמשוך את&המתג^1, הוא&ייצור חידה.../",
 "SCR_TEXT_957": "שאף אחד&לא ראה אף פעם!/",
 "SCR_TEXT_958": "אפילו אני לא&אדע את הפתרון!/",
 "SCR_TEXT_959": "נייה הה הה^1!&תתכונן...!/%%",
 "SCR_TEXT_965": "אוקיי..^1.&כנראה שאני&אחזור על עצמי.../",
 "SCR_TEXT_966": "\\E0על משבצות&אדומות אי אפשר&לעבור./",
 "SCR_TEXT_967": "משבצות צהובות הן&חשמליות&ומסוכנות./",
 "SCR_TEXT_968": "משבצות כחולות&גורמות לך להילחם&במפלצת./",
 "SCR_TEXT_969": "משבצות ירוקות הן&משבצות מים./",
 "SCR_TEXT_970": "משבצות כתומות&בניחוח תפוזים./",
 "SCR_TEXT_971": "אם דרכת על&כתום^1, אל תדרוך&על ירוק./",
 "SCR_TEXT_972": "\\E3משבצות חומות הן.../",
