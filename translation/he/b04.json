 "SCR_TEXT_5128": " ",
 "SCR_TEXT_5133": "וואו, שגיאה יפה./%%",
 "SCR_TEXT_5136": "\\E0יש^1!&פריסק יהיה&השגריר הכי מושלם!/",
 "SCR_TEXT_5137": "ואני^1, פאפירוס&הגדול.../",
 "SCR_TEXT_5138": "אהיה הקמע&הכי מרהיב!/",
