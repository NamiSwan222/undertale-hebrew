 "SCR_TEXT_5232": "* אבל אם לא תשמעו&  ממני יותר אף פעם.../",
 "SCR_TEXT_5233": "* אם אתם רוצים לדעת&  \"את האמת.\"/",
 "SCR_TEXT_5234": "* תיכנסו בדלת שמצפון&  לפתק הזה./",
 "SCR_TEXT_5235": "* לפחות מגיע לכולכם&  לדעת מה עשיתי./",
 "SCR_TEXT_5236": "* (זה כל מה שהיא כתבה.)/%%",
 "SCR_TEXT_5240": " %%",
 "SCR_TEXT_5250": "* (לקנות ציפס ב-25G?)& &         לקנות       לא \\C",
 "SCR_TEXT_5251": " ",
 "SCR_TEXT_5255": "* (לא נשאר ציפס&  במכונה.)/%%",
 "SCR_TEXT_5256": " ",
 "SCR_TEXT_5274": "* (המכונה הוציאה&  קצת ציפס.)/%%",
 "SCR_TEXT_5275": "* (אין לך מספיק&  זהב.)/%%",
 "SCR_TEXT_5277": "* (אתה סוחב יותר&  מדי חפצים.)/%%",
 "SCR_TEXT_5280": "*%%",
 "SCR_TEXT_5285": "* צלצול..\\E0.\\TT /",
 "SCR_TEXT_5286": "\\F1 %",
 "SCR_TEXT_5290": "* הלו?&* כאן טוריאל./",
 "SCR_TEXT_5291": "* בלי שום סיבה&  מיוחדת...&* מה אתה מעדיף?/",
 "SCR_TEXT_5292": "* קינמון או&  טופי?/",
 "SCR_TEXT_5293": "\\E1* ... רגע^1.&* אל תגיד לי./",
 "SCR_TEXT_5294": "\\E0* זאת הודעת שגיאה!& &  כן          לא      \\C",
 "SCR_TEXT_5295": "\\E0* זה טופי?& &  כן          לא      \\C",
 "SCR_TEXT_5296": "\\E0* זה קינמון?& &  כן          לא      \\C",
 "SCR_TEXT_5297": " ",
 "SCR_TEXT_5309": "\\E0* הי הי הי^1.&* ידעתי./",
 "SCR_TEXT_5310": "\\E1* כשבני אדם נופלים&  לכאן^1, משום מה..^1.&* אני.../",
 "SCR_TEXT_5311": "\\E1* הרבה פעמים אני מרגישה&  שאני כבר מכירה&  אותם./",
 "SCR_TEXT_5312": "\\E0* האמת^1, כשראיתי אותך&  לראשונה^1, הרגשתי.../",
 "SCR_TEXT_5313": "\\E1* ... כאילו אני פוגשת&  חבר ותיק בפעם&  הראשונה./",
 "SCR_TEXT_5314": "\\E0* מוזר^1, נכון?/",
 "SCR_TEXT_5315": "* טוב^1, תודה על&  הבחירה./",
 "SCR_TEXT_5316": "\\TS \\F0 \\T0 %",
 "SCR_TEXT_5317": "* קליק.../%%",
 "SCR_TEXT_5323": "\\E1* אה..^1. הבנתי./",
 "SCR_TEXT_5324": "\\E0* טוב^1, תודה^1.&* להתראות בינתיים./",
 "SCR_TEXT_5325": "\\TS \\F0 \\T0 %",
 "SCR_TEXT_5326": "* קליק.../%%",
 "SCR_TEXT_5337": "* (נראה שאפשר לדלג על&  המונולוג של מטאטון אם&  תסובב אותו עכשיו.)/",
 "SCR_TEXT_5338": "* (מה תעשה?)& &         לדלג        לשמוע שוב\\C",
 "SCR_TEXT_5339": " ",
 "SCR_TEXT_5345": "* (אמרת למטאטון שיש&  משהו מגניב&  מאחוריו.)/%%",
 "SCR_TEXT_5353": " %%",
 "SCR_TEXT_5359": "* אבל.../",
 "SCR_TEXT_5360": "* יש בך משהו אחד&  שתמיד נראה לי&  קצת מוזר./",
 "SCR_TEXT_5361": "* תשמע^1, הגנה עצמית&  אני מבין./",
 "SCR_TEXT_5362": "* זרקו אותך למצבים&  האלה בלי&  שבחרת./",
 "SCR_TEXT_5363": "* אבל.../",
 "SCR_TEXT_5364": "* לפעמים.../",
 "SCR_TEXT_5365": "* אתה מתנהג כאילו&  אתה יודע מה&  הולך לקרות./",
 "SCR_TEXT_5366": "* כאילו כבר עברת&  את כל זה&  פעם./",
 "SCR_TEXT_5367": "* זה קטע מוזר להגיד^1,&  אבל.../",
 "SCR_TEXT_5368": "\\W* אם יש לך איזשהו&  \\Yכוח מיוחד\\W.../",
 "SCR_TEXT_5369": "* אז זאת לא האחריות&  שלך לעשות&  את הדבר הנכון?/",
 "SCR_TEXT_5370": "\\TS \\F0 \\T0 %",
 "SCR_TEXT_5371": " & &         כן          לא\\C",
 "SCR_TEXT_5372": " ",
 "SCR_TEXT_5379": "\\E1* אה./",
 "SCR_TEXT_5380": "\\E0* הבנתי./",
 "SCR_TEXT_5381": "\\E3* .../%%",
 "SCR_TEXT_5390": "\\E1* הה./",
 "SCR_TEXT_5391": "\\E0* טוב^1, זאת הדעה&  שלך./",
 "SCR_TEXT_5392": "\\E2* אני לא אשפוט&  אותך על זה./",
 "SCR_TEXT_5393": "\\E3* .../%%",
 "SCR_TEXT_5402": "* (צלצול...)/",
 "SCR_TEXT_5404": "\\E0* היי!/",
 "SCR_TEXT_5405": "\\E3* זה אמ^1, לא קשור בכלל&  להדרכה שלך..^1.&  אבל.../",
 "SCR_TEXT_5406": "\\E2* .../",
 "SCR_TEXT_5407": "\\E6* אהה^1, היי^1, בא לך לראות&  איתי סדרת טלוויזיה&  של בני אדם???/",
 "SCR_TEXT_5408": "* מתישהו???/",
 "SCR_TEXT_5409": "\\E4* קוראים לה^1, אמ^1,&  מ..^1.מיו מיו קיסי&  קיוטי.../",
 "SCR_TEXT_5410": "\\TS \\F0 \\T0 %",
 "SCR_TEXT_5411": " & &         בטח!        ...לא...\\C",
 "SCR_TEXT_5412": " ",
 "SCR_TEXT_5420": "* ב-באמת!?/",
 "SCR_TEXT_5421": "\\E3* היא כל כך טובה^1!&* היא אמ^1, הסדרה&  האהובה עליי!/",
 "SCR_TEXT_5422": "* היא על בחורה אנושית&  בשם מיו מיו שיש&  לה אוזני חתול!%",
 "SCR_TEXT_5423": "\\E3* שלבני אדם אין!&* א-אז היא ממש&  רגישה לגביהן!%",
 "SCR_TEXT_5424": "\\E6* אבל כאילו...&* בסוף!%",
 "SCR_TEXT_5425": "* היא מבינה שהאוזניים&  שלה לא משנות!%",
 "SCR_TEXT_5426": "* שהחברים שלה אוהבים&  אותה למרות האוזניים!%",
 "SCR_TEXT_5427": "\\E7* זה ממש מרגש!%",
 "SCR_TEXT_5428": "\\E5* אופס, ספוילרים%",
 "SCR_TEXT_5429": "\\E6* וגם, זה נשמע מוזר,&  אבל יש לה&  כוח-על!%",
 "SCR_TEXT_5430": "\\E5* לשלוט במוחות של&  כל מי שהיא מנשקת!%",
 "SCR_TEXT_5431": "\\E3* היא מנשקת אנשים&  ושולטת בהם כדי לפתור&  את הבעיות שלה!!%",
 "SCR_TEXT_5432": "\\E5* כלומר הם לא זוכרים&  כלום אחרי&  הנשיקה!!%",
 "SCR_TEXT_5433": "\\E3* אבל אם היא מחטיאה&  את הנשיקה!!!&* אז!!%",
 "SCR_TEXT_5434": "\\E4* אז^1, אה^1, ו^1, אה^1,&  וגם כלומר^1, כמובן%",
 "SCR_TEXT_5435": "\\E5* בסוף^1, היא&  מבינה שלשלוט&  באנשים%",
 "SCR_TEXT_5436": "\\E3* אוקיי אז כמעט&  ספיילרתי את כל&  הסדרה^1, אבל%",
 "SCR_TEXT_5437": "\\E5* אהה^1, נראה לי שממש&  תאהב אותה!!!/",
 "SCR_TEXT_5438": "\\E0* בוא נראה אותה^1!&* אחרי שתעבור את&  כל זה!/",
 "SCR_TEXT_5439": "\\TS \\F0 \\T0 %",
 "SCR_TEXT_5440": "* (קליק...)/%%",
 "SCR_TEXT_5445": "\\E5* אמ^1! טוב^1!&* זה בסדר!/",
 "SCR_TEXT_5446": "* רק רציתי!^1!&* לשאול!!!/",
 "SCR_TEXT_5447": "\\E6* א-אבל נראה לי שממש&  תאהב אותה!!/",
 "SCR_TEXT_5448": "* אם תיתן לה&  צ'אנס!!/",
 "SCR_TEXT_5449": "\\TS \\F0 \\T0 %",
 "SCR_TEXT_5450": "* (קליק...)/%%",
 "SCR_TEXT_5455": "\\M1* שמעת!^1?&* חזרת!/",
 "SCR_TEXT_5456": "\\M0* אגלה לך סוד גדול./",
 "SCR_TEXT_5457": "\\M1* אני מקים להקה^1, שמעת?/",
 "SCR_TEXT_5458": "\\M1* קוראים לה הרד הוט&  צ'יבי פפרז./",
 "SCR_TEXT_5459": "\\M0* כל מה שחשבתי עליו זה&  השם./",
 "SCR_TEXT_5460": "\\M3* ואני לא^1, מנגן...&* בכלים^1, או שר./",
 "SCR_TEXT_5461": "\\M1* נו^1!&* אתה חושב שנהיה&  מפורסמים!!!/",
 "SCR_TEXT_5462": " & &         כן          לא\\C",
 "SCR_TEXT_5463": " ",
 "SCR_TEXT_5471": "\\M0* כן^1, גם אני.../%%",
 "SCR_TEXT_5477": " %%",
 "SCR_TEXT_5485": "* (זאת מנורה.)/",
 "SCR_TEXT_5486": "* (להדליק אותה?)& &         כן          לא\\C",
 "SCR_TEXT_5487": " ",
 "SCR_TEXT_5493": "* (אין נורה.^1)&* (פנס תקוע בתוך&  בית הנורה.)/",
 "SCR_TEXT_5494": "* (להדליק אותו?)& &         כן          לא\\C",
 "SCR_TEXT_5495": " ",
 "SCR_TEXT_5499": " %%",
 "SCR_TEXT_5506": "* (נגמרו לפנס&  הסוללות.)/%%",
 "SCR_TEXT_5510": " %%",
 "SCR_TEXT_5517": "* היי^1, היי^1!&* זכרת איך קוראים לי?/",
 "SCR_TEXT_5518": "* (זכרת?)& &         כן          לא\\C",
 "SCR_TEXT_5519": " ",
 "SCR_TEXT_5527": "* מ-מה!^1?&* אתה זוכר!?/",
 "SCR_TEXT_5528": "* איך ניצחו אותי כל כך&  בקללללללללות!?/%%",
 "SCR_TEXT_5533": "* מ-מה!^1?&* אתה לא זוכר!?/",
 "SCR_TEXT_5534": "* איך ניצחו אותי כל כך&  בקללללללללות!?/%%",
 "SCR_TEXT_5541": "* (זה כלב לבן קטן.^1)&* (הוא ישן עמוק...)/",
 "SCR_TEXT_5542": "* (להילחם בכלב?)& &         כן          לא\\C",
 "SCR_TEXT_5543": " ",
 "SCR_TEXT_5550": "* (אי אפשר להילחם בכלב.)/",
 "SCR_TEXT_5551": "* (נראה שבבד שהוא ישן&  עליו יש יותר מדי&  חורים.)/",
 "SCR_TEXT_5552": "* (נראה שהכלב צריך&  לעשות \"פאץ'\" לבד.)/",
 "SCR_TEXT_5553": "* (ואז אפשר להילחם בכלב.^1)&* (... אולי.)/",
 "SCR_TEXT_5554": "* (במבט מקרוב^1,&  נראה שהחורים בבד&  הולכים וגדלים.)/",
 "SCR_TEXT_5555": "* (ייקח לכלב זמן לתקן&  את כולם.)/",
 "SCR_TEXT_5556": "* (כלבים בדרך כלל לא&  טובים בסריגה.)/",
 "SCR_TEXT_5557": "* (כלב שסורג במסרגה&  זה לא בא בחשבון.)/%%",
 "SCR_TEXT_5561": "* (עדיף לתת לכלב ישן לישון^1,&  במקום להילחם בו.^1)&* (ככה לפחות אומרים.)/%%",
 "SCR_TEXT_5566": "* (טוק טוק)./",
 "SCR_TEXT_5569": "* אוווווההה ^1!&* שירות חדרים !/",
 "SCR_TEXT_5570": "* הבאת את ה\"תה ים\" שלי ?& &         כן          לא\\C",
 "SCR_TEXT_5571": " ",
 "SCR_TEXT_5575": "* שירות החדרים לא הגיע ^1.&* (אנחה ...)/%%",
 "SCR_TEXT_5581": "* תודה מיליון ./%%",
 "SCR_TEXT_5585": "* (אין תגובה.)/%%",
 "SCR_TEXT_5598": "* (שפכת את תה הים מתחת&  לדלת.)/",
 "SCR_TEXT_5599": "* מה !?!?!?!^2?&* בדיוק כמו שרציתי ^1!&* הנה טיפ ./",
 "SCR_TEXT_5600": "* (קיבלת 99G.)/%%",
 "SCR_TEXT_5604": "* ..^1.&* לא נכון ./%%",
 "SCR_TEXT_5609": "* אז ...!?/%%",
 "SCR_TEXT_5614": "* (טוק טוק)./",
 "SCR_TEXT_5617": "* אוווווההה ^1!&* שירות חדרים !/",
 "SCR_TEXT_5618": "* הבאת לי \"לחמניית קינמון\" ?& &         כן          לא\\C",
 "SCR_TEXT_5619": " ",
 "SCR_TEXT_5623": "* שירות החדרים לא הגיע ^1.&* (אנחה ...)/%%",
 "SCR_TEXT_5628": "* תודה טריליון ./%%",
 "SCR_TEXT_5632": "* (אין תגובה.)/%%",
 "SCR_TEXT_5646": "* (שיטחת את לחמניית הקינמון&  עד שהיא דקה כמו נייר.)&* (החלקת אותה מתחת לדלת.)/",
 "SCR_TEXT_5647": "* מה !?!?!?!^2?&* בדיוק כמו שרציתי ^1!&* הנה טיפ ./",
 "SCR_TEXT_5648": "* (קיבלת 99G.)/%%",
 "SCR_TEXT_5652": "* ..^1.&* לא נכון ./%%",
 "SCR_TEXT_5657": "* אז ...!?/%%",
 "SCR_TEXT_5662": "* (אתה שומע דשדוש.)/",
 "SCR_TEXT_5663": "* (נראה שאפשר להכניס&  משהו מתחת לדלת.)/",
 "SCR_TEXT_5664": " & &         לשים        לא לשים\\C",
 "SCR_TEXT_5665": " ",
 "SCR_TEXT_5669": "* (אין תגובה.)/%%",
 "SCR_TEXT_5676": "* (...)/",
 "SCR_TEXT_5677": "* (אבל אין לך שום דבר&  מפתה.)/%%",
 "SCR_TEXT_5705": "* (שמת נקניקייה מול&  הדלת.)/",
 "SCR_TEXT_5706": "* (כפה לבנה מזנקת החוצה&  מתחת לדלת.)/",
 "SCR_TEXT_5707": "* (היא מנסה למשוך את הנקניקייה&  לתוך החדר...)/",
 "SCR_TEXT_5708": "* (אבל היא כל הזמן לוחצת חזק&  מדי^1, והנקניקייה כל הזמן&  מסתובבת ומתרחקת.)/",
 "SCR_TEXT_5709": "* (...)/",
 "SCR_TEXT_5710": "* (סוף סוף היא מצליחה.)/",
 "SCR_TEXT_5711": "* (...)/",
 "SCR_TEXT_5712": "* (אתה שומע חריקה של&  אבן.)/",
 "SCR_TEXT_5713": "* (כלבלב שקט אחד מחליק&  החוצה מתחת לדלת.)/",
 "SCR_TEXT_5714": "* (קיבלת כלבלב שקט.)/%%",
 "SCR_TEXT_5720": "* (שמת נקניחתול מול&  הדלת.)/",
 "SCR_TEXT_5721": "* (אתה שומע נהמה...)/%%",
 "SCR_TEXT_5727": "* (שמת סלט כלבים מול&  הדלת.^1)&* (הוא מחליק פנימה.)/",
 "SCR_TEXT_5728": "* (...)/",
 "SCR_TEXT_5729": "* (סלט הכלבים נבלע&  בחושך.)/%%",
 "SCR_TEXT_5736": "* (שמת שאריות כלב מול&  הדלת.)/",
 "SCR_TEXT_5737": "* (הן מחליקות מתחת לדלת^1,&  כאילו נמשכו במגנט.)/",
 "SCR_TEXT_5738": "* (...)/",
 "SCR_TEXT_5743": "* (זוווםםם!!^1!)&* (הן נורות בחזרה החוצה&  במהירות!)/%%",
 "SCR_TEXT_5747": "* (שתי שאריות כלב מחליקות&  לאט בחזרה החוצה מתחת&  לדלת.)/%%",
 "SCR_TEXT_5755": " %%",
 "SCR_TEXT_5761": "* כן^1, אנחנו יודעים^1.&* המעלית לעיר&  לא עובדת./",
 "SCR_TEXT_5762": "* בגלל התקרית הזאת^1, החדרים&  במחיר מיוחד!/",
 "SCR_TEXT_5763": "* 200G לחדר^1. מעוניין^1?& &         להישאר      לא\\C",
 "SCR_TEXT_5764": " ",
 "SCR_TEXT_5768": "* 200G לחדר^1. מעוניין^1?& &         להישאר      לא\\C",
 "SCR_TEXT_5769": " ",
 "SCR_TEXT_5774": "* נהנית אצלנו?/",
 "SCR_TEXT_5775": "* מה^1?&* מפתח..^1.&* לחדר?/",
 "SCR_TEXT_5776": "* לא^1, אצלנו אין דבר&  כזה./",
 "SCR_TEXT_5777": "* אם תצא מהחדר^1,&  תצטרך לשלם שוב./",
 "SCR_TEXT_5778": "* 200G לחדר^1. מעוניין^1?& &         להישאר      לא\\C",
 "SCR_TEXT_5779": " ",
 "SCR_TEXT_5791": "* נהדר^1!&* נלווה אותך&  לחדר!/%%",
 "SCR_TEXT_5797": "* ... זה לא מספיק כסף./%%",
 "SCR_TEXT_5802": "* תודיע לנו אם תשנה&  את דעתך^1.&* שיהיה יום מנצנץ!/%%",
 "SCR_TEXT_5807": "* ... אהבתי האמיתית היחידה?/",
 "SCR_TEXT_5808": "* .../",
 "SCR_TEXT_5809": "* (אתה נראה משועמם^1, מותק.)/",
 "SCR_TEXT_5810": "* (אני רוצה שזאת תהיה הופעה&  מטורפת^1, אז אם אתה לא&  נותן את כל מה שיש לך...)/",
 "SCR_TEXT_5811": "* (אז אדלג קדימה למען&  הקהל.)/",
 "SCR_TEXT_5812": "* (להופיע?)& &         כן          לדלג\\C",
 "SCR_TEXT_5813": " ",
 "SCR_TEXT_5819": "* (מובן.^1)&* (בוא נפיל אותם מהכיסאות!)/%%",
 "SCR_TEXT_5823": "* (או-אנחה...^1)&* (ההצגה חייבת להימשך!)/%%",
 "SCR_TEXT_5829": "מעניין./",
 "SCR_TEXT_5830": "אתה רוצה לחזור./",
 "SCR_TEXT_5831": "אתה רוצה לחזו^1ר&אל העול^2ם&שהשמדת./",
 "SCR_TEXT_5832": "אתה זה שדחף&את הכ^1ל אל הקצה./",
 "SCR_TEXT_5833": "אתה זה שהוביל את&העול^1ם להרס שלו./",
 "SCR_TEXT_5834": "אבל אתה לא מסוגל&לקבל את זה./",
 "SCR_TEXT_5835": "אתה חושב שלמעשים&שלך אין השלכות.&         כן          לא\\C",
 "SCR_TEXT_5836": "",
 "SCR_TEXT_5842": "בדיוק./%%",
 "SCR_TEXT_5846": "אז מה אתה מחפש?/%%",
 "SCR_TEXT_5851": "אולי./",
 "SCR_TEXT_5852": "נוכל להגיע לפשרה./",
 "SCR_TEXT_5853": "עדיין יש לך משה^1ו&שאני רוצה./",
 "SCR_TEXT_5854": "תן לי אותו./",
