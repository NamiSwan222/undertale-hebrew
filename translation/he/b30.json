 "scr_papcall_3170": "* אמרתי ל-RG01 ו-RG02&  שאם יצליחו&  לתפוס אותך.../",
 "scr_papcall_3171": "\\E9* אני אקח את שניהם&  לגלידה./",
 "scr_papcall_3172": "\\E0* אני מקווה שהצלחת&  להתחמק מהם./",
 "scr_papcall_3173": "\\E6* כי אני שונאת&  גלידה!!/%%",
 "scr_papcall_3179": "כמעט תפסתי&אותך.../",
 "scr_papcall_3180": "איפה הגלידה&שלי./%%",
 "scr_papcall_3187": "הוט-ל.../",
 "scr_papcall_3188": "\\E0זה קיצור של&הוטלנד^1, נכון?/%%",
 "scr_papcall_3194": "וואו-וואו!/%%",
