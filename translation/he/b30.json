 "scr_papcall_3401": "במעלית&כתוב R1./",
 "scr_papcall_3402": "\\E3אבל מה ה-R&אומר^1?&רביולי?/",
 "scr_papcall_3403": "\\E0רביולי..^1.&הפסטה הממולאת&כמו כיסונים./",
 "scr_papcall_3404": "תיבת האוצר&של עולם&הבישול./%%",
