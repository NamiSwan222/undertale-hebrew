 "scr_papcall_3135": "* (יש הפרעה&  מוזרה בקו...)/%%",
 "scr_papcall_3144": "מה?&אני^1? לצעוק?/",
 "scr_papcall_3145": "\\E0בטח^1!&אני אנסה./",
 "scr_papcall_3146": "א^1. א^1. א^1. א^1. א./",
 "scr_papcall_3147": "אני צועק ממש&לאט./%%",
 "scr_papcall_3152": "א./%%",
 "scr_papcall_3160": "* מה!^1?&* RG01 ו-RG02&  מתבטלים?!/",
